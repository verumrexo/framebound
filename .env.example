# Optional legacy multiplayer/game server.
VITE_SERVER_URL=http://127.0.0.1:3000

# Tiny WebRTC signaling service. It exchanges connection metadata only.
VITE_SIGNALING_URL=http://127.0.0.1:3000

# Public leaderboard configuration. The anon key is public by design; RLS must
# still deny unsafe database operations.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
