{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Framebound Enemy Lab",
  "identifier": "com.verumrexo.framebound.enemylab",
  "build": {
    "beforeBuildCommand": "node scripts/build-frontend.mjs --flavor enemy-lab",
    "features": ["part-lab"]
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Framebound Enemy Lab",
        "width": 1600,
        "height": 980,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "backgroundThrottling": "disabled",
        "center": true
      }
    ]
  }
}
