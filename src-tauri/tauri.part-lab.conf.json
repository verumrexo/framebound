{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Framebound Part Lab",
  "identifier": "com.verumrexo.framebound.partlab",
  "build": {
    "beforeBuildCommand": "node scripts/build-frontend.mjs --flavor part-lab",
    "features": ["part-lab"]
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Framebound Part Lab",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "backgroundThrottling": "disabled",
        "center": true
      }
    ]
  }
}
